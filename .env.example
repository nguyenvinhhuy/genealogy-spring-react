# Copy to .env and fill in. Never commit .env.
# Required: compose refuses to start without it. Pick your own, e.g. openssl rand -base64 24
DB_PASSWORD=

# Host port for Postgres, loopback only. 5433 by default so it does not collide with a local install.
POSTGRES_PORT=5433

# Host ports for the API and the dev server, loopback only. Change if they collide on your machine.
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Origins the browser may call the API from, comma-separated. Defaults to both loopback spellings of :5173.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required, at least 32 bytes for HS256; the app refuses a short or placeholder value. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Photos are stored on Cloudinary, in development too: a free account at https://cloudinary.com, three values.
MEDIA_BUCKET=genealogy-media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Behind a reverse proxy in production, set this or every sign-in counts against the proxy's address,
# and twenty wrong passwords from anyone lock the whole clan out for 15 minutes:
# SERVER_FORWARD_HEADERS_STRATEGY=native
# and name the proxy's own address, a regex. Left at Tomcat's default, any private-range address is trusted,
# so a client on the same LAN can send its own X-Forwarded-For and guess passwords without limit:
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.0\.0\.5
# In dev every browser reaches the backend through Vite's proxy and shares one address: the per-address limit
# then means the whole clan, which is accepted there and only matters once the proxy above is in place.

# Backup: a plain dump of the whole gia phả, to be kept somewhere other than this machine.
#   docker exec genealogy_postgres pg_dump -U postgres -Fc genealogy > genealogy.dump
# Photos live on Cloudinary and need no copy from here.
