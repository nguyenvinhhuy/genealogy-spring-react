# Copy to .env for running the backend outside docker compose.
DB_URL=jdbc:postgresql://localhost:5432/genealogy
DB_USER=postgres
DB_PASSWORD=postgres

CORS_ORIGINS=http://localhost:5173

# Must be at least 32 bytes for HS256. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Object storage. Against `docker compose up minio`, the endpoint is localhost.
STORAGE_PROVIDER=minio
MEDIA_BUCKET=genealogy-media
MINIO_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Only needed when STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
